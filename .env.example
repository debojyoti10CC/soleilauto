VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
VITE_SOLEIL_PROGRAM_ID=
VITE_SOLEIL_QUOTES_URL=/api/quotes
# Agent server relays quotes from an internal Soleil maker gateway.
# SOLEIL_MAKER_QUOTES_URL=http://127.0.0.1:8787/quotes
# Optional for local development: start and monitor the sibling maker gateway automatically.
# SOLEIL_LOCAL_GATEWAY_WORKSPACE=C:/Users/you/Downloads/soleil
# Server only. Add values here in .env.local or set in the shell; never use VITE_ prefix.
# GEMINI_API_KEY=
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# SNOWFLAKE_TOKEN=
# Full Cortex Search query endpoint, e.g. https://ACCOUNT.snowflakecomputing.com/api/v2/databases/DB/schemas/SCHEMA/cortex-search-services/SOLEIL_EVIDENCE_SEARCH:query
# SNOWFLAKE_CORTEX_SEARCH_URL=
# For Vultr / Docker, the backend serves dist and listens on 0.0.0.0.
# HOST=0.0.0.0
# AGENT_PORT=8788
